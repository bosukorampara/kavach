# KAVACH Environment Configuration
# Copy this file to .env and update with your values

# Flask Configuration
FLASK_HOST=0.0.0.0
FLASK_PORT=5001
FLASK_DEBUG=True
FLASK_SECRET_KEY=your-secret-key-change-this-in-production

# Database Configuration
DATABASE_PATH=data/kavach.db
AUDIT_DB_PATH=data/audit_trail.db
HONEYTOKEN_DB_PATH=data/honeytokens.db

# Kafka Configuration (for real-time streaming)
KAFKA_ENABLED=False
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=security-events
KAFKA_CONSUMER_GROUP=kavach-consumer

# Model Configuration
MODEL_DIR=models/
BREACH_DETECTOR_MODEL=models/breach_detector.joblib
ANOMALY_DETECTOR_MODEL=models/anomaly_detector.joblib
AUTOENCODER_MODEL=models/autoencoder_ueba.pkl
BEHAVIOR_ANALYZER_MODEL=models/behavior_analyzer.joblib
EVENT_STORAGE_DB=data/events.db
ENSEMBLE_ENABLED=True
CONSENSUS_THRESHOLD=0.5

# UEBA Configuration
UEBA_ENABLED=True
UEBA_DEVIATION_THRESHOLD=2.0
UEBA_BASELINE_DAYS=30
USE_AUTOENCODER=False

# Honeytoken Configuration
HONEYTOKEN_ENABLED=True
HONEYTOKEN_DB_PATH=data/honeytokens.db
HONEYTOKEN_CHECK_INTERVAL=60

# Security Configuration
ANONYMIZE_PII=True
ENABLE_ENCRYPTION=True
AUDIT_TRAIL_ENABLED=True
COMPLIANCE_MODE=STRICT

# GDPR/CCPA Compliance
GDPR_COMPLIANT=True
CCPA_COMPLIANT=True
DATA_RETENTION_DAYS=30
AUTO_DELETE_EXPIRED=True

# Logging Configuration
LOG_DIR=logs/
LOG_LEVEL=INFO
LOG_FORMAT=JSON
AUDIT_LOG_RETENTION_DAYS=365

# Dashboard Configuration
DASHBOARD_ENABLED=True
DASHBOARD_HOST=localhost
DASHBOARD_PORT=3001
DASHBOARD_REFRESH_INTERVAL=30

# Chatbot Configuration
CHATBOT_ENABLED=True
CHATBOT_RASA_ENABLED=False
CHATBOT_RASA_ENDPOINT=http://localhost:5005

# Performance Configuration
MAX_CONCURRENT_REQUESTS=100
CACHE_ENABLED=True
CACHE_TTL=300
BATCH_SIZE=32

# Monitoring & Alerting
ALERT_WEBHOOK_URL=
ALERT_EMAIL_ENABLED=False
ALERT_EMAIL_SMTP_HOST=
ALERT_EMAIL_SMTP_PORT=
ALERT_EMAIL_USER=
ALERT_EMAIL_PASSWORD=

# API Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# Feature Flags
FEATURE_ENSEMBLE_CONSENSUS=True
FEATURE_CONTEXTUAL_FILTERS=True
FEATURE_REAL_TIME_STREAMING=False
FEATURE_ADVANCED_UEBA=True
FEATURE_AUTOENCODER=False
FEATURE_INSIDER_THREAT_DETECTION=True


